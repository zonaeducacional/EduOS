{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EduOS",
  "version": "0.1.0",
  "identifier": "br.eduos.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:factory",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "EduOS",
      "width": 1280,
      "height": 720,
      "center": true,
      "minWidth": 640,
      "minHeight": 440
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
