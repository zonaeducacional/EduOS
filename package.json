{
  "name": "eduos",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": "^22.12.0 || >=24" },
  "scripts": {
    "dev": "pnpm --filter @eduos/desktop dev",
    "build": "pnpm --filter @eduos/desktop build",
    "build:factory": "pnpm --filter @eduos/desktop build:factory",
    "lint": "eslint . --max-warnings 0",
    "svelte-check": "pnpm --filter @eduos/desktop svelte-check",
    "test": "vitest run",
    "tauri": "pnpm --filter @eduos/desktop exec tauri"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-svelte": "^3",
    "typescript-eslint": "^8",
    "typescript": "~5.9.3",
    "vitest": "^4"
  }
}
